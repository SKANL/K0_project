{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K0",
  "identifier": "com.boop.k0",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "K0", "width": 1180, "height": 780, "minWidth": 320, "minHeight": 480 }],
    "security": { "capabilities": ["main-capability"] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": { "minimumSystemVersion": "11.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "__TAURI_UPDATER_PUBLIC_KEY__",
      "endpoints": ["https://github.com/SKANL/K0_project/releases/latest/download/latest.json"]
    }
  }
}
